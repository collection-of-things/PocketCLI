# Optional build-time configuration. `cp .env.example .env` and fill in what you need.
# Everything here is a public identifier, not a secret. Do not add server-side secrets.
# Leave a variable unset to build without that feature.

# --- Mobile app identity (apps/mobile) -------------------------------------
# EAS project and account that own the mobile builds and OTA updates.
# Run `eas init` in apps/mobile to create a project, then paste its id here.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
# EAS_OWNER=your-expo-account
# Apple Developer team used to sign iOS builds non-interactively.
# EXPO_APPLE_TEAM_ID=ABC1234567
# Set to 0 to disable OTA updates even when EAS_PROJECT_ID is configured.
# T3CODE_MOBILE_UPDATES_ENABLED=0

# --- Optional relay (self-hosted T3 Connect) -------------------------------
# PocketCLI connects to servers over LAN, Tailscale, or a tunnel without any of
# this. Configure it only if you deploy your own relay (infra/relay) and Clerk
# instance; see docs/operations/connect-setup.md.
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_...
# T3CODE_CLERK_JWT_TEMPLATE=relay
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=...
# T3CODE_RELAY_URL=https://relay.example.com
# Relying-party domain for passkeys and universal links (the Clerk Frontend API host).
# EXPO_PUBLIC_CLERK_RP_DOMAIN=clerk.example.com

# --- Optional telemetry -----------------------------------------------------
# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=pocketcli-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
